<%# locals: (placeholder:, url:) %>

<%= admin_form url:, method: :get, html: { class: "sm:max-w-xl" } do |f| %>
  <% request.query_parameters.except("search", "page").each do |key, value| %>
    <%= f.hidden_field key, value: %>
  <% end %>

  <div class="flex items-end gap-3">
    <div class="min-w-0 flex-1">
      <%= f.search_input :search, value: params[:search], placeholder: %>
    </div>

    <%= f.submit "Search", class: "shrink-0" %>
  </div>
<% end %>
