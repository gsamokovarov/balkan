<%= section_navigation :partnerships %>

<%= render "section", title: "Sponsorships", cta: -> {
  admin_button(:primary, link: new_admin_event_sponsorship_package_path) { "New sponsorship package" }
} do %>
  <%= render "pills", pills: [
    { name: "Sponsorships", path: admin_event_sponsorships_path(Current.event) },
    { name: "Packages", path: admin_event_sponsorship_packages_path(Current.event) },
  ] %>

  <% if @sponsorship_packages.any? %>
    <%= render "sponsorship_packages", sponsorship_packages: @sponsorship_packages %>
  <% else %>
    <%= render "empty_state" do %>
      <% admin_button(:primary, link: new_admin_event_sponsorship_package_path) { "New sponsorship package" } %>
    <% end %>
  <% end %>
<% end %>
