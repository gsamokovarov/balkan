<%# locals: (brand:) %>

<style>
  :root { color-scheme: light only; }

  body, table, td {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  body { margin: 0; padding: 0; }

  .block { display: block; }
  .w-full { width: 100%; }
  .w-16 { width: 4rem; }
  .w-44 { width: 11rem; }
  .w-prose { width: 100%; }
  .h-auto { height: auto; }
  .max-w-2xl { max-width: 42rem; }
  .mt-6 { margin-top: 1.5rem; }
  .p-3 { padding: 0.75rem; }
  .p-8 { padding: 2rem; }
  .px-4 { padding-left: 1rem; padding-right: 1rem; }
  .py-10 { padding-top: 2.5rem; padding-bottom: 2.5rem; }
  .pt-8 { padding-top: 2rem; }
  .pb-2 { padding-bottom: 0.5rem; }
  .pb-7 { padding-bottom: 1.75rem; }
  .pb-14 { padding-bottom: 3.5rem; }
  .align-middle { vertical-align: middle; }
  .border-collapse { border-collapse: collapse; }

  .antialiased { -webkit-font-smoothing: antialiased; }
  .text-left { text-align: left; }
  .text-center { text-align: center; }
  .text-base { font-size: 1rem; line-height: 1.5rem; }
  .font-semibold { font-weight: 600; }

  .bg-black { background-color: #000000; }
  .text-white { color: #FFFFFF; }

  .text-brand-content { color: <%= brand["content"] %>; }
  .bg-brand-base { background-color: <%= brand["base"] %>; }
  .bg-brand-card { background-color: <%= brand["card"] %>; }
  .border-brand-line { border-color: <%= brand["line"] %>; }

  .border-2 { border-width: 2px; border-style: solid; }
  .rounded-md { border-radius: 0.375rem; }
  .shadow-brutal { box-shadow: 4px 4px <%= brand["shadow"] %>; }
  .shadow-brutal-md { box-shadow: 6px 6px <%= brand["shadow"] %>; }

  .dot-grid {
    background-image: radial-gradient(<%= brand["100"] %> 1.5px, transparent 1.6px);
    background-size: 16px 16px;
  }

  .prose p { margin: 0 0 1rem; }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    margin: 1.5rem 0 0.75rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .prose h1 { font-size: 2rem; font-weight: 900; margin-top: 0; }
  .prose h2 { font-size: 1.5rem; }
  .prose h3 { font-size: 1.25rem; }
  .prose h4 { font-size: 1.125rem; }
  .prose h5,
  .prose h6 { font-size: 1rem; }

  .prose strong,
  .prose b { font-weight: 700; }

  .prose ul,
  .prose ol { margin: 0 0 1rem; padding-left: 1.75rem; }

  .prose li { margin-bottom: 0.25rem; }

  .prose hr {
    border: 0;
    border-top: 2px solid <%= brand["line"] %>;
    margin: 2rem 0;
  }

  .prose blockquote {
    margin: 1rem 0;
    padding: 0.75rem 1rem 1px;
    border-left: 4px solid <%= brand["500"] %>;
    background-color: <%= brand["50"] %>;
  }

  .prose code {
    background-color: <%= brand["100"] %>;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .prose pre {
    background-color: <%= brand["50"] %>;
    border: 2px solid <%= brand["line"] %>;
    border-radius: 0.375rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 0 0 1rem;
  }

  .prose pre code { background-color: transparent; padding: 0; }

  .prose img { max-width: 100%; }

  .prose a,
  .link-primary {
    color: <%= brand["600"] %>;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .prose a:hover,
  .link-primary:hover { color: <%= brand["700"] %>; }

  .btn-primary,
  .prose a.btn-primary {
    display: inline-block;
    padding: 0.75rem 2rem;
    border: 2px solid <%= brand["line"] %>;
    border-radius: 0.25rem;
    background-color: #000000;
    color: #FFFFFF;
    font-weight: 600;
    text-decoration: none;
  }

  .btn-primary:hover,
  .prose a.btn-primary:hover { background-color: <%= brand["500"] %>; color: #FFFFFF; }

  @media (max-width: 480px) {
    .px-4 { padding-left: 0.75rem; padding-right: 0.75rem; }
    .p-8 { padding: 1.25rem; }
  }
</style>
