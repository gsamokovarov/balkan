<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light only">
    <meta name="supported-color-schemes" content="light only">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    >

    <%= render "layouts/mailer_styles", brand: brand_palette %>
  </head>

  <body class="antialiased bg-brand-base text-brand-content text-base">
    <table role="presentation" class="w-full bg-brand-base dot-grid" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="px-4 pt-8 pb-14" align="center">
          <table role="presentation" class="w-full max-w-2xl" width="100%" cellpadding="0" cellspacing="0" border="0">
            <% if attachments["logo.png"] %>
              <tr>
                <td class="pb-7 text-left">
                  <%= image_tag attachments["logo.png"].url, class: "block w-44 h-auto", width: 176, alt: "Logo" %>
                </td>
              </tr>
            <% end %>

            <tr>
              <td class="prose p-8 text-left text-base text-brand-content bg-brand-card border-2 border-brand-line rounded-md shadow-brutal-md">
                <%= yield %>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <tr>
        <td class="px-4 py-10 bg-black" align="center">
          <table role="presentation" class="w-full max-w-2xl" width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td class="text-left text-base font-semibold text-white">
                A <%= link_to "Neuvents", neuvents_url, class: "text-white" %> event.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
