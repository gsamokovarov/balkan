<% title "Thank you" %>

<div data-controller="napkins" class="px-5 py-16 sm:p-10">
  <canvas data-napkins-target="canvas" class="absolute top-0 left-0 z-50 w-full pointer-events-none" aria-hidden="true"></canvas>

  <section class="mx-auto max-w-2xl space-y-8 rounded-md border-2 border-brand-line bg-brand-card p-8 shadow-brutal-md sm:p-12">
    <h1 class="text-4xl font-extrabold text-balance sm:text-6xl">
      Thank you! <span class="text-brand-500">You're in.</span>
    </h1>

    <%= render "prose", variant: "lg" do %>
      <p>
        Your ticket for <%= Current.event.name %> is on its way to your
        inbox. If it doesn't show up in a few minutes, or you have any
        questions, feel free to <%= mail_to Current.event.contact_email, "contact us", class: "link-primary" %>.
      </p>

      <p>
        Around here, a good night ends with napkins in the air. These are on us.
      </p>
    <% end %>

    <div class="flex flex-wrap gap-4">
      <button type="button" class="btn-primary motion-reduce:hidden" data-action="napkins#throw">
        Throw more napkins
      </button>
    </div>
  </section>
</div>
